{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pattern Writer",
  "version": "0.2.0",
  "identifier": "com.xdam99.patternmania",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Patternmania",
        "width": 1220,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Éditeur simple de patterns pour Discord",
    "longDescription": "Crée une suite de notes colorées et copie-la dans Discord, sans mesure ni BPM."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFRkI1QzBFRkU3RDA4QjgKUldTNENIMytEbHo3L3RLZmx5ajFhRDJUNkFvSHZ4VmhzdnZ5SzZDWG8zTHF6dllTMGZxaVlub1oK",
      "endpoints": [
        "https://rythmania.fr/updates/patternmania/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
